{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actually-fine.tnsor-labs.dev/schema/contract-ir-1.0.json",
  "title": "actually-fine Contract IR 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ir_version", "contract", "input", "rules"],
  "properties": {
    "ir_version": {"const": "1.0"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "record-stream"}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "predicate", "on_breach"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "const": "1", "default": "1"},
          "kind": {"const": "record"},
          "path": {"type": "string", "pattern": "^\\$(\\.|$)"},
          "predicate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["op"],
            "properties": {
              "op": {"enum": ["required", "type", "format", "regex", "range", "enum"]},
              "type": {"enum": ["string", "number", "integer", "boolean", "object", "array"]},
              "format": {"const": "email"},
              "pattern": {"type": "string"},
              "min": {"type": "number"},
              "max": {"type": "number"},
              "values": {"type": "array"}
            }
          },
          "on_breach": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action"],
            "properties": {
              "severity": {"enum": ["warning", "error"], "default": "error"},
              "action": {"enum": ["warn", "reject", "quarantine", "halt"]}
            }
          }
        }
      }
    }
  }
}
